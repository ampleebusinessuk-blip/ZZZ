# Copy to .env and adjust for production.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7
DB_PATH=./data/app.db
CORS_ORIGIN=*
BCRYPT_ROUNDS=10
NODE_ENV=development

# Required for reliable calls across mobile, corporate, and home networks.
# Prefer your own coturn host with TLS enabled.
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SECRET=change-me-to-a-separate-long-random-string
TURN_TTL=43200
